# ─────────────────────────────────────────────────────────────
# 이 파일을 .env로 복사해서 쓴다.  cp .env.example .env
# .env는 커밋하지 않는다.
# ─────────────────────────────────────────────────────────────

# 데이터베이스 -----------------------------------------------
# 로컬 개발: docker compose up -d db 로 띄운 Postgres (호스트 5433 포트)
DATABASE_URL="postgresql://gbsw:gbsw_dev_password@localhost:5433/gbsw"

# docker compose가 db 컨테이너를 만들 때 쓰는 값. DATABASE_URL과 맞춰야 한다.
POSTGRES_USER="gbsw"
POSTGRES_PASSWORD="gbsw_dev_password"
POSTGRES_DB="gbsw"

# 인증 -------------------------------------------------------
# 세션 쿠키 서명 키. 운영에서는 반드시 새로 생성할 것:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-교체할것-openssl-rand-base64-32"

# 서버가 자기 자신을 가리키는 절대 URL. 운영에서는 https://... 로 바꾼다.
# 부팅 시 콘솔에 찍히는 최초 관리자 생성 링크도 이 주소를 쓴다.
BETTER_AUTH_URL="http://localhost:3000"

# 문자 발송 (알리고) -------------------------------------------
# 비우면 인증번호가 서버 콘솔에만 찍힌다 (개발 기본값).
# SMS_SENDER는 알리고에 사전 등록된 발신번호여야 한다.
SMS_KEY=""
SMS_USER_ID=""
SMS_SENDER=""
# 연동 확인용. Y로 두면 요청은 처리되지만 실제 발송·과금이 없다.
SMS_TEST_MODE="true"

# 목업 인증 (개발 전용) ----------------------------------------
# true면 인증번호를 화면에 자동으로 채워 넣고 실제 발송을 건너뛴다.
# 운영 빌드(NODE_ENV=production)에서는 이 값과 무관하게 항상 꺼진다.
VERIFICATION_MOCK="false"
