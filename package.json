{
  "name": "gbsw-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run sanitize:standalone && npm run prepare:standalone && npm run verify:standalone",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:list": "VISUAL_COMPARE_DRY_RUN=1 playwright test --config playwright.visual.config.ts --list",
    "visual:fixtures": "tsx scripts/prepare-visual-fixtures.ts",
    "visual:build:baseline": "npm --prefix dev-local/ui-baseline-b81abf7 ci && npm --prefix dev-local/ui-baseline-b81abf7 run build",
    "visual:build:redesign": "npm run build",
    "sanitize:standalone": "node scripts/sanitize-standalone.mjs",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "verify:standalone": "node scripts/check-standalone.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test:setup": "bash scripts/setup-test-db.sh",
    "seed:merit": "tsx scripts/seed-merit-rules.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "auth:generate": "npx @better-auth/cli generate --config src/core/auth/auth.ts",
    "postinstall": "prisma generate",
    "verify:unit": "npm run typecheck && npm run lint && npm run test:coverage",
    "verify": "npm run verify:unit && npm run db:test:setup && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.26",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.10",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "uqr": "0.1.3",
    "write-excel-file": "4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
