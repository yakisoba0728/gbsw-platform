generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 인증 코어 필드는 Better Auth 생성 스키마와 함께 관리한다.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// ADMIN | STUDENT | PARENT
  role String?

  phone String

  /// ACTIVE | INACTIVE
  status String? @default("ACTIVE")

  /// 비밀번호 초기화 후 다음 요청에서 변경을 강제한다.
  mustChangePassword Boolean? @default(false)

  /// 명단 파일에서 빠진 학생은 이 시각을 기록해 로그인·일반 목록에서 제외한다.
  /// 사용자 상세의 명시적 완전 삭제만 행을 지우며, 그 전까지 업무 기록은 보존한다.
  deletedAt DateTime?

  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  studentProfile StudentProfile?
  auditLogs      AuditLog[]

  parentLinks ParentStudent[]

  invitesCreated Invite[] @relation("InviteCreatedBy")
  inviteUsed     Invite?  @relation("InviteUsedBy")

  meritAwardsGiven     MeritAward[] @relation("MeritAwardedBy")
  meritAwardsCancelled MeritAward[] @relation("MeritCancelledBy")

  meritThresholdsSet MeritThreshold[] @relation("MeritThresholdUpdatedBy")

  passesRequested Pass[] @relation("PassRequestedBy")
  passesConsented Pass[] @relation("PassConsentedBy")
  passesDecided   Pass[] @relation("PassDecidedBy")
  passesCancelled Pass[] @relation("PassCancelledBy")

  communityPosts       CommunityPost[]       @relation("CommunityPostAuthor")
  communityComments    CommunityComment[]    @relation("CommunityCommentAuthor")
  communityAttachments CommunityAttachment[] @relation("CommunityAttachmentUploader")

  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 대리 로그인한 원 관리자 User.id.
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// credential 공급자의 비밀번호 해시.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// id는 업무 기록의 불변 참조다. 매년 바뀌는 학급·번호나 교체되는 Enrollment를 식별자로 쓰지 않는다.
model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 명단 파일에서 사용하는 불변 학생 코드.
  studentCode String @unique

  /// 초대의 사전등록 값과 대조하며 KST 자정으로 저장한다.
  birthDate DateTime

  enrollments Enrollment[]

  meritAwards MeritAward[]

  passes Pass[]

  parents ParentStudent[]

  parentInvites Invite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 가입 초대코드에 귀속된 학생과 연결한다. 가입자가 학생을 선택하지 않는다.
model ParentStudent {
  id String @id @default(cuid())

  parentUserId String
  parentUser   User   @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentUserId, studentId])
  @@index([studentId])
}

/// 현재 학년도는 SQL 마이그레이션의 부분 유니크 인덱스 AcademicYear_single_current로 하나만 허용한다.
/// Prisma 선언에는 없으며 전환은 기존 isCurrent를 먼저 내린 뒤 새 행을 올린다.
model AcademicYear {
  year      Int      @id
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  meritAwards MeritAward[]
}

/// grade·classNo·number는 보통 ENROLLED일 때만 채우지만 **강제되지 않는다.**
/// 양방향 모두 깨지므로 CHECK 제약으로 만들지 마라 —
/// enrollment.repo.applyAll은 좌석 유니크 제약과 부딪치지 않으려고 ENROLLED인 채로
/// 좌석을 먼저 null로 비우고(CHECK는 문장마다 즉시 검사하므로 그 중간에서 터진다),
/// enrollment.schema의 enrollmentChangeSchema는 status와 좌석을 서로 독립으로 두어
/// 교사가 화면에서 GRADUATED에 학년·반·번호를 함께 저장할 수 있다.
model Enrollment {
  id String @id @default(cuid())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  year         Int
  academicYear AcademicYear @relation(fields: [year], references: [year], onDelete: Restrict)

  grade   Int?
  classNo Int?
  number  Int?

  /// src/core/authz/enrollment-status.ts의 EnrollmentStatus.
  status String @default("ENROLLED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentProfileId, year])
  /// Postgres의 NULL은 서로 달라 비재학·미배정 학생끼리는 충돌하지 않는다.
  @@unique([year, grade, classNo, number])
  @@index([year])
}

model Invite {
  id   String @id @default(cuid())
  code String @unique

  /// ADMIN | STUDENT | PARENT. 가입 역할은 클라이언트 입력 대신 여기서 읽는다.
  role String

  /// PENDING | USED | REVOKED
  status String @default("PENDING")

  expiresAt DateTime?

  /// 사전등록 신원: STUDENT는 name·birthDate·grade·classNo·number, 나머지는 name.
  metadata Json?

  /// PARENT 코드의 연결 대상. 학생이 발급하면 서버가 세션에서 유도한다.
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// 신원 대조가 5회 실패하면 코드를 폐기한다.
  failedAttempts Int @default(0)

  createdById   String?
  createdBy     User?  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// 발급 당시 이름 스냅샷. 발급자 계정 삭제 후에도 보존한다.
  createdByName String

  usedById String?   @unique
  usedBy   User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdById])
  @@index([studentId])
}

/// 요청 사이의 확인 proof를 저장하고 가입 트랜잭션에서 한 번만 소진한다.
/// 발송한 코드가 확인되어야 verifiedAt이 채워진다.
model VerificationCode {
  id String @id @default(cuid())

  /// EMAIL | PHONE
  channel String

  target String

  /// 코드 원본 대신 SHA-256 해시를 저장한다.
  codeHash String

  expiresAt DateTime

  attempts Int @default(0)

  verifiedAt DateTime?

  consumedAt DateTime?

  /// 대상을 바꿔 반복 요청하는 남용을 IP별로 제한한다. 요청 컨텍스트 밖에서는 null.
  requestIp String?

  createdAt DateTime @default(now())

  @@index([channel, target])
  @@index([requestIp, createdAt])
}

/// 변경 기록은 추가만 하며 계정 삭제 후에도 행위자 이름 스냅샷을 보존한다.
model AuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actor       User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  actorName String

  action     String
  targetType String
  targetId   String?
  metadata   Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  /// 계정 관련 감사 조회의 actorUserId OR targetId 조건을 지원한다.
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

/// SCHOOL은 학년도별, DORM은 누적으로 집계한다. 삭제는 비활성화하고 부여 기록은 보존한다.
model MeritRule {
  id String @id @default(cuid())

  track String
  /// MERIT | DEMERIT | OFFSET. 순점수 = 상점 + 상쇄점 - 벌점.
  kind  String

  label String
  /// 항상 양수이며 부호는 kind가 정한다.
  points Int

  category    String?
  description String?

  active Boolean @default(true)

  awards MeritAward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([track, active])
}

/// 트랙별 행이 없으면 DEFAULT_DEMERIT_THRESHOLDS를 사용한다. danger는 warn보다 커야 한다.
model MeritThreshold {
  track String @id

  warn Int
  danger Int

  updatedAt DateTime @updatedAt

  updatedByUserId String?
  updatedBy       User?   @relation("MeritThresholdUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  /// 변경 당시 이름 스냅샷.
  updatedByName String
}

/// 규정·교사 이름은 부여 당시 스냅샷이다. 교내 합계는 year로 제한하고 기숙사는 누적한다.
model MeritAward {
  id String @id @default(cuid())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  year         Int
  academicYear AcademicYear @relation(fields: [year], references: [year], onDelete: Restrict)

  ruleId String
  rule   MeritRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  track  String
  kind   String
  label  String
  points Int

  /// KST 자정의 발생일. 입력 시각인 createdAt과 구분한다.
  occurredOn DateTime

  note String?

  awardedByUserId String?
  awardedBy       User?   @relation("MeritAwardedBy", fields: [awardedByUserId], references: [id], onDelete: SetNull)
  awardedByName String

  /// ACTIVE | CANCELLED. 취소 기록은 남기고 합계에서 제외한다.
  status String @default("ACTIVE")

  cancelledByUserId String?
  cancelledBy       User?     @relation("MeritCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledByName   String?
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt DateTime @default(now())

  @@index([studentProfileId, track])
  @@index([year, track])
  @@index([track, createdAt(sort: Desc)])
}

/// 학생 프로필에 연결하며 요청·동의·결재·취소 시점의 이름을 스냅샷으로 보존한다.
model Pass {
  id String @id @default(cuid())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// OUTING | OVERNIGHT
  type String

  /// REQUESTED | CONSENTED | APPROVED | REJECTED | CANCELLED. 만료는 endAt으로 계산한다.
  status String @default("REQUESTED")

  /// KST 입력 시각. 유효 범위는 startAt 이상, endAt 미만이다.
  startAt DateTime
  endAt   DateTime

  destination String
  reason      String

  requestedByUserId String?
  requestedBy       User?   @relation("PassRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByName   String

  consentedByUserId String?
  consentedBy       User?     @relation("PassConsentedBy", fields: [consentedByUserId], references: [id], onDelete: SetNull)
  consentedByName   String?
  consentedAt       DateTime?
  /// 교사가 외박의 보호자 확인을 대신 기록한 경우.
  consentByProxy    Boolean   @default(false)
  consentNote       String?

  decidedByUserId String?
  decidedBy       User?     @relation("PassDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?

  cancelledByUserId String?
  cancelledBy       User?     @relation("PassCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledByName   String?
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentProfileId, startAt(sort: Desc)])
  @@index([status, endAt])
}

model Community {
  id String @id @default(cuid())

  /// 링크를 유지하기 위해 생성 후 바꾸지 않는다.
  slug        String  @unique
  name        String
  description String?

  /// ADMIN은 항상 허용하며 writeRoles는 readRoles의 부분집합이다.
  readRoles  String[]
  writeRoles String[]

  /// 게시판 전체의 글·댓글 작성자를 감춘다.
  anonymous        Boolean @default(false)
  allowAttachments Boolean @default(true)

  sortOrder Int @default(0)
  /// 연결된 글을 보존하므로 삭제는 비활성화한다.
  active Boolean @default(true)

  posts CommunityPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// 계정 삭제 후에도 이름·역할 스냅샷으로 작성자 표시를 유지한다.
model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  title String
  body  String @db.Text

  authorUserId String?
  authorUser   User?   @relation("CommunityPostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String
  authorRole String

  /// 댓글·첨부가 연결되어 있어 글 삭제는 표시만 남긴다.
  deletedAt DateTime?

  comments    CommunityComment[]
  attachments CommunityAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId, deletedAt, createdAt])
}

model CommunityComment {
  id     String        @id @default(cuid())
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  body String @db.Text

  authorUserId String?
  authorUser   User?   @relation("CommunityCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String
  authorRole   String

  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([postId, deletedAt, createdAt])
}

/// 글 제출 전에 생성한다. postId가 1시간 넘게 null이면 고아 첨부다.
model CommunityAttachment {
  id String @id @default(cuid())

  postId String?
  post   CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 게시된 글의 첨부는 계정 삭제 후에도 보존하며, 연결 전에는 업로더만 사용할 수 있다.
  uploaderUserId String?
  uploaderUser   User?   @relation("CommunityAttachmentUploader", fields: [uploaderUserId], references: [id], onDelete: SetNull)

  /// 경로 탈출을 막기 위해 원래 파일명 대신 랜덤 32자를 디스크 이름으로 쓴다.
  storageKey String @unique
  filename String
  mimeType String
  size     Int

  createdAt DateTime @default(now())

  @@index([uploaderUserId, postId])
}
