// GBSW 통합관리시스템 — 데이터 모델
//
// 뼈대 단계 범위: 인증 코어 + 신원(프로필/학급) + 감사로그 + 상벌점(교내/기숙사).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7부터 url은 prisma.config.ts에서 주입한다.
}

// ─────────────────────────────────────────────────────────────
// 1. 인증 코어 — Better Auth가 소유하는 테이블
//    스키마를 손으로 고치기 전에 `npm run auth:generate`로 대조할 것.
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── 플랫폼 확장 필드
  /// ADMIN | STUDENT | PARENT — src/core/authz/roles.ts와 일치해야 한다.
  role String?

  /// 필수. 가입·최초 관리자 생성 모두에서 받고, 관리자가 고칠 수 있다.
  phone String

  /// ACTIVE | INACTIVE
  status String? @default("ACTIVE")

  /// 관리자가 비밀번호를 초기화하면 true. (app) 레이아웃에서 가로채 /change-password로 보낸다.
  mustChangePassword Boolean? @default(false)

  /// 명단에서 빠진 계정. null이면 살아 있다.
  /// 소프트 삭제 — 계정·프로필·상벌점·감사로그·지난 학년도 배정은 그대로 두고
  /// 목록·로그인에서만 제외한다. 단, 명단 반영으로 빠진 경우 **그 학년도 배정은
  /// 함께 사라진다** — 명단에서 줄을 지웠다는 건 그 학년도에 있으면 안 될
  /// 사람이라는 뜻이다. 자퇴·전출은 줄을 지우는 게 아니라 학적 칸으로 기록한다.
  /// 진짜 삭제(오등록 정리)는 사용자 상세에서 한 명씩 하며 그때는 행이 사라진다.
  /// status(활성/비활성)와 직교한다 — 비활성 해제와 삭제 복구는 다른 일이다.
  deletedAt DateTime?

  // ── Better Auth admin 플러그인
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  studentProfile StudentProfile?
  auditLogs      AuditLog[]

  /// 학부모로서 연결된 학생들
  parentLinks ParentStudent[]

  invitesCreated Invite[] @relation("InviteCreatedBy")
  inviteUsed     Invite?  @relation("InviteUsedBy")

  /// 이 사람이 부여한 상벌점 / 취소한 상벌점. 계정이 지워지면 SetNull로 끊긴다.
  meritAwardsGiven     MeritAward[] @relation("MeritAwardedBy")
  meritAwardsCancelled MeritAward[] @relation("MeritCancelledBy")

  /// 이 사람이 마지막으로 고친 벌점 기준. 계정이 지워지면 SetNull로 끊긴다.
  meritThresholdsSet MeritThreshold[] @relation("MeritThresholdUpdatedBy")

  // 거의 모든 목록 조회가 이 조건(deletedAt: null)으로 거른다.
  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// admin 플러그인 — 관리자가 대리 로그인한 경우 원 관리자 User.id
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// 해시된 비밀번호 (providerId = "credential"인 경우)
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// 2. 신원 / 조직
// ─────────────────────────────────────────────────────────────

/// 학생 신원.
///
/// **이 모델의 id가 학생을 추적하는 불변 식별자다.** 상벌점·외출 등 모든 기록이 이걸 참조한다.
/// 학년·반·번호는 매년 갱신되는 "현재 소속"이므로 식별자로 쓰지 않는다.
model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 학생 식별자. 명단 파일의 첫 열이며 절대 바뀌지 않는다.
  /// src/lib/student-code.ts가 만든다.
  studentCode String @unique

  /// 가입 시 초대코드의 사전등록 값과 대조하는 2차 요소.
  birthDate DateTime

  /// 학년도별 소속·학적
  enrollments Enrollment[]

  /// 상벌점. 학생이 완전 삭제되면 함께 사라진다 (오등록 정리).
  meritAwards MeritAward[]

  /// 이 학생에게 연결된 학부모들
  parents ParentStudent[]

  /// 이 학생이 발급한 학부모 초대코드들
  parentInvites Invite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 학부모 ↔ 학생 연결. 학부모가 초대코드로 가입할 때 만들어진다.
/// 코드 자체에 학생이 귀속되어 있으므로 학부모가 대상을 고를 여지가 없다.
model ParentStudent {
  id String @id @default(cuid())

  parentUserId String
  parentUser   User   @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentUserId, studentId])
  @@index([studentId])
}

/// 학년도. **현재 학년도는 항상 하나뿐**이며, 그것을 DB가 직접 막는다.
///
/// 그 제약은 부분 유니크 인덱스 `AcademicYear_single_current`
/// (`ON "AcademicYear" ("isCurrent") WHERE "isCurrent"`)이고,
/// `prisma/migrations/20260813005023_academic_year_and_enrollment/migration.sql`에
/// 손으로 적혀 있다. **Prisma는 부분 인덱스를 표현하지 못해 여기에 대응 선언이
/// 없다** — 즉 스키마만 보면 이 인덱스는 존재하지 않는 것처럼 보인다.
///
/// 그래서 `prisma migrate dev`가 스키마와 섀도 DB를 비교하면 이 인덱스를
/// **군더더기로 보고 `DROP INDEX`를 생성할 수 있다.** 드롭돼도 아무 오류가 나지
/// 않는다는 것이 위험한 지점이다: `isCurrent = true`인 행이 둘이 되고,
/// `academic-year.repo.findCurrent()`는 `findFirst`라 어느 쪽이 나올지 모른 채
/// 전교 상벌점의 집계 범위가 요청마다 흔들린다.
///
/// **마이그레이션을 새로 만들면 생성된 SQL을 눈으로 확인하고, 이 인덱스를 지우는
/// 줄이 있으면 지워라.** 같은 이유로 `academic-year.repo.setCurrent`는 "먼저 전부
/// 내리고 나서 올린다"는 순서를 지켜야 하고,
/// `tests/integration/academic-year.single-current.integration.test.ts`가 이
/// 불변식을 통째로 검증한다.
model AcademicYear {
  year      Int      @id
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  classes     SchoolClass[]
  enrollments Enrollment[]
  meritAwards MeritAward[]
}

/// 학년/반. 학년도마다 별개의 행이다 — "1학년 3반"이 해마다 새로 생긴다.
model SchoolClass {
  id        String   @id @default(cuid())
  year      Int
  grade     Int
  classNo   Int
  createdAt DateTime @default(now())

  academicYear AcademicYear @relation(fields: [year], references: [year], onDelete: Restrict)
  enrollments  Enrollment[]

  @@unique([year, grade, classNo])
  @@index([year])
}

/// 학생의 그 학년도 소속과 학적.
/// classId·number는 ENROLLED일 때만 채운다 — 졸업·자퇴에 반과 번호는 의미가 없다.
model Enrollment {
  id String @id @default(cuid())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  year         Int
  academicYear AcademicYear @relation(fields: [year], references: [year], onDelete: Restrict)

  classId     String?
  // 반이 지워져도 지난 학년도 소속 기록은 남아야 한다 ("기록은 지우지 않는다").
  // academicYear와 같은 이유로 Restrict — SetNull이면 SchoolClass 삭제 한 번에
  // 그 반을 거쳐간 모든 학년도의 Enrollment에서 반 정보가 조용히 사라진다.
  schoolClass SchoolClass? @relation(fields: [classId], references: [id], onDelete: Restrict)

  number Int?

  /// src/core/authz/enrollment-status.ts의 EnrollmentStatus와 일치해야 한다.
  status String @default("ENROLLED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 한 학생은 한 학년도에 한 줄. 동시 요청은 애플리케이션 검사로 못 막는다.
  @@unique([studentProfileId, year])
  /// 한 반에 같은 번호 둘을 막는다. Postgres는 NULL을 서로 다르게 보므로
  /// 비재학 행끼리는 걸리지 않는다 — 의도한 동작이다.
  @@unique([classId, number])
  @@index([year])
  @@index([studentProfileId])
}

// ─────────────────────────────────────────────────────────────
// 3. 초대코드 — 계정 생성의 유일한 경로 (부트스트랩 제외)
// ─────────────────────────────────────────────────────────────

model Invite {
  id   String @id @default(cuid())
  code String @unique

  /// ADMIN | STUDENT | PARENT
  /// 가입 시 역할은 항상 이 값에서 읽는다. 클라이언트가 주장할 수 없다.
  role String

  /// PENDING | USED | REVOKED
  status String @default("PENDING")

  /// null이면 무기한
  expiresAt DateTime?

  /// 사전등록 신원. 가입 시 2차 요소로 대조한다.
  ///   STUDENT       { name, birthDate, grade, classNo, number }
  ///   ADMIN·PARENT  { name }
  metadata Json?

  /// PARENT 코드 전용 — 이 코드로 가입한 학부모가 연결될 학생.
  /// 학생 본인이 코드를 만들 때 서버가 세션에서 채운다.
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// 2차 요소 대조 실패 횟수. 5회 도달 시 코드를 폐기한다.
  failedAttempts Int @default(0)

  createdById String
  createdBy   User   @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// 코드 하나는 계정 하나만 만든다.
  usedById String?   @unique
  usedBy   User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdById])
  @@index([studentId])
}

/// 가입 시 이메일·전화번호 확인용 일회성 코드.
///
/// 가입은 여러 요청에 걸쳐 일어나므로 메모리가 아니라 DB에 둔다.
/// 계정이 만들어지면 consumedAt이 찍혀 재사용되지 않는다.
model VerificationCode {
  id String @id @default(cuid())

  /// EMAIL | PHONE
  channel String

  /// 정규화된 이메일 주소 또는 휴대폰 번호
  target String

  /// 코드 원본은 저장하지 않는다 (SHA-256).
  codeHash String

  expiresAt DateTime

  /// 코드 대조 실패 횟수. 한계에 닿으면 만료시킨다.
  attempts Int @default(0)

  /// 대조에 성공한 시각. 가입 시 이 값이 있어야 통과한다.
  verifiedAt DateTime?

  /// 가입에 실제로 쓰인 시각. 찍히면 더는 못 쓴다.
  consumedAt DateTime?

  /// 발송을 요청한 접속 IP (I4). 대상(target)은 공격자가 마음대로 바꿀 수
  /// 있어 대상별 제한만으로는 한 IP가 임의의 번호마다 계속 발송을 촉발하는
  /// 것을 막지 못한다 — IP별 제한의 근거로 쓴다. 요청 컨텍스트 밖(테스트 등)
  /// 에서는 비어 있을 수 있다.
  requestIp String?

  createdAt DateTime @default(now())

  @@index([channel, target])
  @@index([expiresAt])
  @@index([requestIp, createdAt])
}

// ─────────────────────────────────────────────────────────────
// 4. 감사로그 — 모든 변경 작업이 여기로 남는다 (append-only)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(cuid())

  /// 계정이 지워지면 null이 된다. 기록 자체는 남아야 하므로 Restrict를 쓰지 않는다.
  actorUserId String?
  actor       User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// 기록 시점의 행위자 이름. 계정이 사라져도 "누가 했는지"가 남아야 한다.
  /// 과거의 사실이 살아 있는 외래키에 기대면 안 된다.
  actorName String

  /// core/authz/can.ts의 Action 문자열과 같은 형식. 예) "merit:award"
  action     String
  targetType String
  targetId   String?
  metadata   Json?

  /// 요청 접속 정보. 요청 밖(부팅 훅·스크립트)에서 남긴 기록은 비어 있다.
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// 5. 상벌점 — 교내(그린마일리지, 학년도별) · 기숙사(누적)
// ─────────────────────────────────────────────────────────────

/// 규정 카탈로그. 관리자가 만들고, 부여 화면의 선택지가 된다.
model MeritRule {
  id String @id @default(cuid())

  /// SCHOOL | DORM — src/core/authz/merit-track.ts의 MeritTrack과 일치해야 한다.
  track String
  /// MERIT | DEMERIT | OFFSET — 같은 파일의 MeritKind와 일치해야 한다.
  /// OFFSET(상쇄점)은 상점이 아니다 — 선도관리위원회가 벌점을 덜어내는 조치이며
  /// 순점수에서만 만난다 (순점수 = 상점 + 상쇄점 − 벌점).
  kind  String

  label String
  /// 항상 양수. 부호는 kind가 정한다 — 음수를 허용하면 "벌점 −3점"처럼
  /// 같은 뜻을 두 갈래로 표현할 수 있게 되고, 합계 계산이 어느 쪽을 믿을지 모호해진다.
  points Int

  category    String?
  description String?

  /// false면 부여 목록에서 감춘다. 이미 나간 기록이 참조하므로 행은 남긴다.
  active Boolean @default(true)

  awards MeritAward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([track, active])
}

/// 벌점 누적 기준. 관리자가 설정 화면에서 정한다.
///
/// **트랙 하나에 행 하나**라 track이 곧 기본키다 (별도 id·유니크 인덱스가 필요 없다).
/// **행이 없는 상태가 정상이다** — 한 번도 설정하지 않은 학교는 코드 기본값
/// (DEFAULT_DEMERIT_THRESHOLDS)으로 떨어진다. 마이그레이션으로 행을 심지 않는
/// 근거는 src/modules/merit/threshold.service.ts에 있다.
model MeritThreshold {
  /// SCHOOL | DORM — src/core/authz/merit-track.ts의 MeritTrack과 일치해야 한다.
  track String @id

  /// 이 점수부터 진하게 표시하고 "기준 초과 학생" 명단에 올린다.
  warn Int
  /// 이 점수부터 붉은 배경. 항상 warn보다 크다 (merit.schema.ts·threshold.service.ts).
  danger Int

  updatedAt DateTime @updatedAt

  /// 계정이 지워지면 null이 된다 — 다른 책임 추적 필드와 같은 규약이다.
  updatedByUserId String?
  updatedBy       User?   @relation("MeritThresholdUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  /// 마지막으로 고친 사람의 이름 스냅샷. AuditLog.actorName과 같은 이유 —
  /// 과거의 사실이 살아 있는 외래키에 기대면 안 된다.
  updatedByName String
}

/// 부여 기록. 규정 값을 부여 시점에 복사해 둔다.
model MeritAward {
  id String @id @default(cuid())

  /// **학생의 영구 식별자에 매단다. Enrollment가 아니다.**
  /// 명단 일괄 반영(applyRoster)은 그 학년도 재적 행을 지우고 다시 넣으므로,
  /// 재적을 참조하면 명단을 한 번 올릴 때마다 전교생 상벌점이 끊어진다.
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// 부여된 학년도. 교내 합계의 범위이자 기숙사 기록의 시점 표시.
  year         Int
  academicYear AcademicYear @relation(fields: [year], references: [year], onDelete: Restrict)

  /// 규정 행은 지우는 경로가 없다(비활성만 있다). "이 규정으로 몇 건 나갔나"에 쓴다.
  ruleId String
  rule   MeritRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  // ── 부여 시점 스냅샷. 규정이 나중에 바뀌어도 과거 기록은 안 흔들린다.
  track  String
  kind   String
  label  String
  points Int

  /// **실제로 그 일이 일어난 날.** KST 자정으로 저장한다 (StudentProfile.birthDate와
  /// 같은 규약 — src/lib/datetime.ts의 parseDateInputKst 하나만 거친다).
  ///
  /// createdAt(입력한 시각)과 나누는 이유: 교사는 금요일 일을 월요일에 넣고,
  /// 사감은 어젯밤 점호를 다음 날 아침에 넣는다. 하나로 두면 그 차이가 메모의
  /// 자연어("6월 12일 점호")로 새고, 월별 추이는 엉뚱한 달을 세며, 선도위에
  /// 내는 근거 자료에 틀린 날짜가 박힌다.
  ///
  /// createdAt은 그대로 남는다 — 그쪽은 "언제 입력됐나"라는 감사 사실이다.
  occurredOn DateTime

  note String?

  /// 계정이 지워지면 null이 된다 — 오등록 완전 삭제를 막지 않기 위해서다.
  awardedByUserId String?
  awardedBy       User?   @relation("MeritAwardedBy", fields: [awardedByUserId], references: [id], onDelete: SetNull)
  /// 부여 시점의 이름 스냅샷. AuditLog.actorName과 같은 이유 —
  /// 과거의 사실이 살아 있는 외래키에 기대면 안 된다.
  awardedByName String

  /// ACTIVE | CANCELLED. 취소해도 행은 남는다 (목록에 취소 표시로 보인다).
  status String @default("ACTIVE")

  cancelledByUserId String?
  cancelledBy       User?     @relation("MeritCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledByName   String?
  cancelledAt       DateTime?
  cancelReason      String?


  createdAt DateTime @default(now())

  /// 학생 한 명의 트랙별 조회·집계 — 가장 잦은 질의다.
  @@index([studentProfileId, track])
  /// 반별 목록(그 학년도 전체를 훑는다).
  @@index([year, track])
  /// 최근 부여 목록 — 트랙별 입력 최신순 페이지네이션.
  @@index([track, createdAt(sort: Desc)])
}
